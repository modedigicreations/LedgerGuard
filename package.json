{
  "name": "ledgerguard",
  "version": "1.0.0",
  "type": "module",
  "description": "LedgerGuard — Autonomous Cross-Platform Financial Auditor & Reconciliation Engine (MCP Server & AI Plugin for Claude, ChatGPT, and Standalone)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ledgerguard": "./dist/bin/run-stdio.js",
    "ledgerguard-server": "./dist/bin/run-http.js",
    "ledgerguard-cron": "./dist/bin/run-cron.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "dev:stdio": "tsx src/bin/run-stdio.ts",
    "dev:http": "tsx src/bin/run-http.ts",
    "dev:cron": "tsx src/bin/run-cron.ts",
    "start": "node dist/bin/run-stdio.js",
    "start:http": "node dist/bin/run-http.js",
    "start:cron": "node dist/bin/run-cron.js",
    "generate:manifests": "tsx src/scripts/generate-manifests.ts",
    "test": "tsx tests/test-reconciler.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ledgerguard",
    "financial-auditor",
    "reconciliation",
    "stripe",
    "plaid",
    "quickbooks",
    "netsuite",
    "gaap",
    "claude-mcp",
    "chatgpt-plugin",
    "custom-gpt-action"
  ],
  "author": "LedgerGuard Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "content-disposition": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
